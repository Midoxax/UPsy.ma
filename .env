# Sentry error reporting. A DSN is a write-only ingest endpoint and is public by
# design — it ships in the client bundle regardless of where it is stored, and
# grants no read access to the project. Removing this line disables Sentry
# entirely; src/lib/analytics/sentry.ts is gated on it.
#
# The ingest host must also be present in the CSP connect-src in vercel.json, or
# the browser blocks every event and Sentry silently receives nothing.
VITE_SENTRY_DSN="https://cfa1d782c10701805b8dae52cf32a92e@o4511311085633536.ingest.de.sentry.io/4511315886669904"

# Public origin for canonical tags, og:url, hreflang and the sitemap.
# The apex 308-redirects to www, so www is the canonical destination.
VITE_SITE_URL="https://www.upsy.ma"

# Social sign-in providers that are actually configured in Supabase Auth.
# Empty means the Google/Apple buttons do not render at all — they were live
# and failing for every visitor because no client secret exists in Supabase.
# Set to "google" only after completing the setup in src/config/auth.ts AND
# a real sign-in. See DEPLOYMENT.md.
VITE_OAUTH_PROVIDERS=""
